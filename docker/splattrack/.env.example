# Frames per second to extract from each video.
# Lower number leads to fewer frames extracted, speeding up processing, lowering memory usage, resulting in less accurate results.
# Setting it to 0 will extract every frame.
EXTRACT_FPS=0

# Max number of SIFT features detected per image in COLMAP.
# Lower number leads to quicker processing, lower memory usage, but less stable track.
SIFT_MAX_NUM_FEATURES=8192

# Max image dimension (in pixels) fed to SIFT in COLMAP.
# Lower resolution leads to lower amount of features extracted and less reliable tracking.
SIFT_MAX_IMAGE_SIZE=3200

# Number of CPU threads for SIFT extraction and matching in COLMAP.
# Set to number of CPU cores you want to dedicate.
SIFT_NUM_THREADS=8

# Number of overlapping frames for sequential matching in COLMAP.
# Lower number leads to less accurate tracking.
SEQUENTIAL_OVERLAP=15

# Whether to use GPU for processing in COLMAP and Brush.
# Possible values: true/false/auto
# GPU processing hugely increases the processing speed but requires a video card with CUDA support.
# Note: 3D Gaussian Splatting construction (Brush) needs GPU processing.
USE_GPU=true

# Whether to generate 3D Gaussian Splatting using Brush.
GAUSSIAN_SPLAT=true

# Number of training iterations Brush runs.
# Lower value leads to quicker processing but less accurate results.
BRUSH_TRAIN_ITERS=30000
